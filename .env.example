NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://jajacare:jajacare@localhost:5432/jajacare?schema=public
# Reverse proxies in front of the API (1 on Render/Railway/Fly). Keep 0 when running locally.
TRUST_PROXY=0
CORS_ORIGINS=https://jajacare.vercel.app,https://jajacare-*.vercel.app,http://localhost:5173

# Auth: generate with `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ACCESS_TTL=15m
# Sliding idle timeout: every refresh issues a new token with a fresh window.
# No activity for this many minutes = forced logout.
REFRESH_IDLE_MINUTES=30
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30

# Seed users (dev only)
SEED_PASSWORD=ChangeMe123!
